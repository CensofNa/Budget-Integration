# Database Connection (PostgreSQL with pgboss schema for pg-boss queueing)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prod_latest_local?schema=public"

# Entrata API Configuration
ENTRATA_BASE_URL="https://apis.entrata.com"
ENTRATA_API_KEY="your-entrata-api-key-here"

# Domain Service Port Configurations
PROPERTY_SERVICE_PORT=3001
BUDGET_SERVICE_PORT=3002
RENT_DETAILS_SERVICE_PORT=3003
PORT=3000

# Worker Settings
# Controls whether domain services run background pg-boss workers internally (default: true)
ENABLE_EMBEDDED_WORKER=true
SYNC_INCOME_STATEMENT_ACTUALS_CONCURRENCY=1
