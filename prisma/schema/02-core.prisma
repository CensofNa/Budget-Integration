model User {
  id                             String                       @id @default(uuid()) @db.Uuid
  principalType                  UserPrincipalType            @default(COMPANY)
  status                         UserStatus                   @default(INVITED)
  firstName                      String
  lastName                       String
  displayName                    String?
  email                          String                       @unique
  phone                          String?
  designation                    String?
  notes                          String?
  profileMetadata                Json?
  lastLoginAt                    DateTime?
  passwordChangedAt              DateTime?
  isSystemHidden                 Boolean                      @default(false)
  companyId                      String?                      @db.Uuid
  organisationId                 String?                      @db.Uuid
  isPrimaryCompanyAdmin          Boolean                      @default(false)
  isRootOrganisationAdmin        Boolean                      @default(false)
  employeeCode                   String?
  invitedAt                      DateTime?
  activatedAt                    DateTime?
  createdAt                      DateTime                     @default(now())
  updatedAt                      DateTime                     @updatedAt
  auditEventsActed               AuditLog[]                   @relation("AuditActorUser")
  auditEventsImpersonated        AuditLog[]                   @relation("AuditImpersonatedUser")
  authIdentities                 AuthIdentity[]
  businessRolesCreated           BusinessRole[]               @relation("BusinessRoleCreatedBy")
  businessAssignmentsMade        BusinessRoleAssignment[]     @relation("BusinessRoleAssignmentAssignedBy")
  businessRoleAssignments        BusinessRoleAssignment[]     @relation("UserBusinessRoleAssignment")
  companiesCreated               Company[]                    @relation("CompanyCreatedBy")
  companiesModified              Company[]                    @relation("CompanyModifiedBy")
  organisationsCreated           Organisation[]               @relation("OrganisationCreatedBy")
  organisationsModified          Organisation[]               @relation("OrganisationModifiedBy")
  otpChallenges                  OtpChallenge[]
  passwordCredential             PasswordCredential?
  managedProperties              Property[]                   @relation("PropertyManager")
  propertyWorkflowAssignments    PropertyWorkflowAssignment[]
  workflowCommentsAuthored       PropertyWorkflowComment[]    @relation("PropertyWorkflowCommentActor")
  assignedProperties             Property[]                   @relation("PropertyAssignedToUser")
  refreshSessions                RefreshSession[]
  assignedPropertyReassignments  PropertyReassignment[]       @relation("UserAssignedPropertyReassignments")
  requestedPropertyReassignments PropertyReassignment[]       @relation("UserRequestedPropertyReassignments")
  systemRolesCreated             SystemRole[]                 @relation("SystemRoleCreatedBy")
  systemRolesModified            SystemRole[]                 @relation("SystemRoleModifiedBy")
  assignedSystemRoles            SystemRoleAssignment[]       @relation("SystemRoleAssignmentAssignedBy")
  systemRoleAssignments          SystemRoleAssignment[]       @relation("SystemRoleAssignmentUser")
  company                        Company?                     @relation("UserCompany", fields: [companyId], references: [id])
  organisation                   Organisation?                @relation("UserOrganisation", fields: [organisationId], references: [id])
  platformCompanyAccess          UserCompanyAccess[]
  createdById                    String?                      @db.Uuid
  modifiedById                   String?                      @db.Uuid
  createdBy                      User?                        @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modifiedBy                     User?                        @relation("UserModifiedBy", fields: [modifiedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersCreated                   User[]                       @relation("UserCreatedBy")
  usersModified                  User[]                       @relation("UserModifiedBy")
  userNotifications              UserNotification[]

  @@index([companyId])
  @@index([organisationId])
  @@index([createdById])
  @@index([modifiedById])
  @@map("user")
}

model AuthIdentity {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @db.Uuid
  provider            AuthProvider
  providerSubject     String
  loginName           String?
  email               String?
  isPrimary           Boolean      @default(false)
  lastAuthenticatedAt DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([provider, loginName])
  @@index([userId])
  @@map("auth_identity")
}

model PasswordCredential {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @db.Uuid
  passwordHash       String
  mustChangePassword Boolean   @default(false)
  failedAttemptCount Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credential")
}

model OtpChallenge {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @db.Uuid
  purpose           OtpPurpose
  channel           OtpChannel
  destinationMasked String?
  codeHash          String
  expiresAt         DateTime
  consumedAt        DateTime?
  attemptCount      Int        @default(0)
  maxAttempts       Int        @default(5)
  metadata          Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_challenge")
}

model RefreshSession {
  id                  String                      @id @default(uuid()) @db.Uuid
  userId              String                      @db.Uuid
  refreshTokenHash    String
  lastUsedAt          DateTime?
  deviceName          String?
  ipAddress           String?
  userAgent           String?
  expiresAt           DateTime
  revokedAt           DateTime?
  revokedReason       RefreshSessionRevokeReason?
  replacedBySessionId String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_session")
}

model SystemRole {
  id                 String                     @id @default(uuid()) @db.Uuid
  code               String                     @unique
  name               String
  description        String?
  dashboardKey       String?
  menuConfig         Json?
  permissionConfig   Json?
  isPlatformManaged  Boolean                    @default(true)
  isActive           Boolean                    @default(true)
  createdByUserId    String?                    @db.Uuid
  createdAt          DateTime                   @default(now())
  updatedByUserId    String?                    @db.Uuid
  updatedAt          DateTime                   @updatedAt
  createdByUser      User?                      @relation("SystemRoleCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser      User?                      @relation("SystemRoleModifiedBy", fields: [updatedByUserId], references: [id])
  assignments        SystemRoleAssignment[]
  pagePermissions    SystemRolePagePermission[]
  assignedProperties SystemRoleProperty[]
  workflowSteps      WorkflowStep[]

  @@index([isActive])
  @@map("system_role")
}

model SystemRoleAssignment {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  systemRoleId     String           @db.Uuid
  scopeType        ScopeType
  scopeRef         String
  companyId        String?          @db.Uuid
  organisationId   String?          @db.Uuid
  propertyId       String?          @db.Uuid
  status           AssignmentStatus @default(ACTIVE)
  isCurrent        Boolean          @default(false)
  assignedByUserId String?          @db.Uuid
  assignedAt       DateTime         @default(now())
  revokedAt        DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  assignedByUser   User?            @relation("SystemRoleAssignmentAssignedBy", fields: [assignedByUserId], references: [id])
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organisation     Organisation?    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  property         Property?        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  systemRole       SystemRole       @relation(fields: [systemRoleId], references: [id], onDelete: Cascade)
  user             User             @relation("SystemRoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, systemRoleId, scopeType, scopeRef])
  @@index([systemRoleId])
  @@index([companyId])
  @@index([organisationId])
  @@index([propertyId])
  @@map("system_role_assignment")
}

model NavigationMenuItem {
  id                 String                     @id @default(uuid()) @db.Uuid
  code               String
  label              String
  icon               String
  route              String?
  section            String?
  sortOrder          Int                        @default(0)
  scopeType          ScopeType
  parentId           String?                    @db.Uuid
  isActive           Boolean                    @default(true)
  isDisabled         Boolean                    @default(false)
  permissionCodes    Json?
  navigationMetadata Json?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  parent             NavigationMenuItem?        @relation("NavigationMenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children           NavigationMenuItem[]       @relation("NavigationMenuHierarchy")
  rolePermissions    SystemRolePagePermission[]

  @@unique([scopeType, code])
  @@index([scopeType, isActive, sortOrder])
  @@index([parentId])
  @@map("navigation_menu_item")
}

model SystemRolePagePermission {
  id                   String   @id @default(uuid()) @db.Uuid
  systemRoleId         String   @db.Uuid
  navigationMenuItemId String   @db.Uuid
  canRead              Boolean  @default(false)
  canCreate            Boolean  @default(false)
  canEdit              Boolean  @default(false)
  canDelete            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  systemRole         SystemRole         @relation(fields: [systemRoleId], references: [id], onDelete: Cascade)
  navigationMenuItem NavigationMenuItem @relation(fields: [navigationMenuItemId], references: [id], onDelete: Cascade)

  @@unique([systemRoleId, navigationMenuItemId])
  @@index([systemRoleId])
  @@index([navigationMenuItemId])
  @@map("system_role_page_permission")
}

model Company {
  id                             String                        @id @default(uuid()) @db.Uuid
  code                           String                        @unique @map("code") @db.VarChar(100)
  name                           String                        @db.VarChar(255)
  isActive                       Boolean                       @default(true) @map("is_actvie")
  shortDisplayName               String?
  isSystemInternal               Boolean                       @default(false)
  industry                       String?
  onboardingStatus               OnboardingStatus              @default(DRAFT)
  accessStatus                   AccessStatus                  @default(ACTIVE)
  registeredAddressLine1         String?
  registeredAddressLine2         String?
  registeredCity                 String?
  registeredState                String?
  registeredPostalCode           String?
  registeredCountry              String?
  primaryContactName             String?
  primaryContactEmail            String?
  primaryContactPhone            String?
  primaryContactDesignation      String?
  billingContactName             String?
  billingContactEmail            String?
  billingContactPhone            String?
  contractStartDate              DateTime?
  contractEndDate                DateTime?
  canCompanyAdminAddOrganisation Boolean                       @default(true)
  notes                          String?
  auditCreatedByUserId           String?                       @db.Uuid
  auditModifiedByUserId          String?                       @db.Uuid
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt
  globalAssumptions              GlobalAssumption[]
  periodicDrivers                PeriodicDriver[]
  proformaScenarios              ProformaScenario[]
  proformaComparableProperties   ProformaComparableProperty[]
  proformaDrivers                ProformaDriver[]
  proformaGlobalAssumptions      ProformaGlobalAssumption[]
  proformaCoaGlobalAssumptions   ProformaCoaGlobalAssumption[]
  auditLogs                      AuditLog[]
  businessRoles                  BusinessRole[]
  businessRoleAssignments        BusinessRoleAssignment[]
  coaAccounts                    CoaAccount[]
  coaAccountGroups               CoaAccountGroup[]
  coaAccountHeads                CoaAccountHead[]
  coaAccountTypes                CoaAccountType[]
  coaAuditLogs                   CoaAuditLog[]
  coaOwners                      CoaOwner[]
  auditCreatedByUser             User?                         @relation("CompanyCreatedBy", fields: [auditCreatedByUserId], references: [id])
  auditModifiedByUser            User?                         @relation("CompanyModifiedBy", fields: [auditModifiedByUserId], references: [id])
  microsoftEntraConfig           CompanyMicrosoftEntraConfig?
  integrationPlugins             IntegrationPlugin[]
  integrationSources             IntegrationSource[]
  integrationSyncRuns            IntegrationSyncRun[]
  organisations                  Organisation[]                @relation("CompanyOrganisations")
  payrollBenefitAssumptions      PayrollBenefitAssumption[]
  payrollGlobalAssumptions       PayrollGlobalAssumption[]
  payrollMethods                 PayrollMethod[]
  payrollPositionAssumptions     PayrollPositionAssumption[]
  payrollPositionOwnerValues     PayrollPositionOwnerValue[]
  payrollStateAssumptions        PayrollStateAssumption[]
  payrollStateConfigs            PayrollStateConfig[]
  overtimeExcludedProperties     OvertimeExcludedProperty[]
  properties                     Property[]
  budgets                        PropertyBudget[]
  propertyUnitTypes              PropertyUnitType[]
  propertyUnits                  PropertyUnit[]
  sourceRecordMaps               SourceRecordMap[]
  stagingApiBatches              StagingApiBatch[]
  stagingBudgets                 StagingBudget[]
  stagingProperties              StagingProperty[]
  stagingPropertyUnits           StagingPropertyUnit[]
  stagingUnitTypes               StagingUnitType[]
  systemRoleAssignments          SystemRoleAssignment[]
  users                          User[]                        @relation("UserCompany")
  platformUserAccess             UserCompanyAccess[]
  workflowDefinitions            WorkflowDefinition[]
  marketRentUnitRates            MarketRentUnitRate[]
  marketRentChangeSets           MarketRentChangeSet[]
  marketRentUnitChanges          MarketRentUnitChange[]
  nonIncomeUnits                 NonIncomeUnit[]
  leaseUpUnits                   LeaseUpUnit[]
  rehabUnits                     RehabUnit[]

  integrationReportRuns        IntegrationReportRun[]
  integrationReportDefinitions IntegrationReportDefinition[]

  stagingReportDatas      StagingReportData[]
  propertyClosingStatuses PropertyClosingStatus[]
  glTrees                 GlTree[]
  propertyGlTrees         PropertyGlTree[]
  stagingBudgetActuals    StagingBudgetActual[]
  propertyGlAccounts      PropertyGlAccount[]
  propertyBudgetActuals   PropertyBudgetActual[]
  glTreeBranches          GlTreeBranch[]
  integrationErrorLogs    IntegrationErrorLog[]
  glAccounts              GlAccount[]
  stagingGlTrees          StagingGlTree[]

  @@index([onboardingStatus])
  @@index([accessStatus])
  @@index([isSystemInternal])
  @@map("company")
}

model PropertyBudget {
  id                    String                    @id @default(uuid()) @db.Uuid
  companyId             String                    @map("company_id") @db.Uuid
  organisationId        String                    @map("organisation_id") @db.Uuid
  propertyId            String                    @map("property_id") @db.Uuid
  sourceBudgetId        String?                   @map("source_budget_id") @db.VarChar(150)
  budgetName            String?                   @map("budget_name") @db.VarChar(250)
  budgetStatusTypeId    String?                   @map("budget_status_type_id") @db.VarChar(50)
  isDefault             Boolean?                  @map("is_default")
  fiscalYear            Int?                      @map("fiscal_year")
  fiscalStartDate       DateTime?                 @map("fiscal_start_date")
  fiscalEndDate         DateTime?                 @map("fiscal_end_date")
  budgetTotal           Decimal?                  @map("budget_total") @db.Decimal(18, 2)
  currencyCode          String?                   @map("currency_code") @db.VarChar(20)
  createdSource         String?                   @map("created_source") @db.VarChar(100)
  updatedSource         String?                   @map("updated_source") @db.VarChar(100)
  lastSyncedAt          DateTime?                 @map("last_synced_at")
  isManuallyOverridden  Boolean                   @default(false) @map("is_manually_overridden")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  glAccounts            PropertyBudgetGlAccount[]
  company               Company                   @relation(fields: [companyId], references: [id])
  organisation          Organisation              @relation(fields: [organisationId], references: [id])
  property              Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyBudgetActuals PropertyBudgetActual[]

  @@unique([companyId, organisationId, propertyId, sourceBudgetId])
  @@index([companyId])
  @@index([organisationId])
  @@index([propertyId])
  @@index([sourceBudgetId])
  @@index([fiscalYear])
  @@map("property_budgets")
}

model PropertyBudgetGlAccount {
  id                    String                        @id @default(uuid()) @db.Uuid
  companyId             String                        @map("company_id") @db.Uuid
  organisationId        String                        @map("organisation_id") @db.Uuid
  budgetId              String                        @map("budget_id") @db.Uuid
  sourceGlAccountId     String?                       @map("source_gl_account_id") @db.VarChar(150)
  accountNumber         String?                       @map("account_number") @db.VarChar(100)
  accountName           String?                       @map("account_name") @db.VarChar(250)
  totalAmount           Decimal?                      @map("total_amount") @db.Decimal(18, 2)
  createdAt             DateTime                      @default(now()) @map("created_at")
  updatedAt             DateTime                      @updatedAt @map("updated_at")
  budget                PropertyBudget                @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  months                PropertyBudgetMonthlyAmount[]
  propertyBudgetActuals PropertyBudgetActual[]

  @@unique([budgetId, sourceGlAccountId])
  @@index([companyId])
  @@index([organisationId])
  @@index([budgetId])
  @@index([sourceGlAccountId])
  @@index([accountNumber])
  @@map("property_budget_gl_accounts")
}

model PropertyBudgetMonthlyAmount {
  id                String                  @id @default(uuid()) @db.Uuid
  companyId         String                  @map("company_id") @db.Uuid
  organisationId    String                  @map("organisation_id") @db.Uuid
  budgetGlAccountId String                  @map("budget_gl_account_id") @db.Uuid
  monthDate         DateTime                @map("month_date")
  monthNo           Int                     @map("month_no")
  fiscalYear        Int?                    @map("fiscal_year")
  amount            Decimal?                @db.Decimal(18, 2)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  budgetGlAccount   PropertyBudgetGlAccount @relation(fields: [budgetGlAccountId], references: [id], onDelete: Cascade)

  @@unique([budgetGlAccountId, monthDate])
  @@index([companyId])
  @@index([organisationId])
  @@index([budgetGlAccountId])
  @@index([monthDate])
  @@index([fiscalYear])
  @@map("property_budget_monthly_amounts")
}

model GlobalAssumption {
  id                   String                             @id @default(uuid()) @db.Uuid
  companyId            String                             @map("company_id") @db.Uuid
  organisationId       String                             @map("organisation_id") @db.Uuid
  coaAccountId         String                             @map("coa_account_id") @db.Uuid
  description          String                             @map("description") @db.VarChar(250)
  method               GlobalAssumptionMethod
  amount               Decimal                            @db.Decimal(18, 5)
  setupFeePerMonth     Decimal                            @map("setup_fee_per_month") @db.Decimal(18, 5)
  amountPostingMonth   Int?                               @map("amount_posting_month")
  setupFeePostingMonth Int?                               @map("setup_fee_posting_month")
  updatedBy            String?                            @map("updated_by") @db.VarChar(100)
  createdAt            DateTime                           @default(now()) @map("created_at")
  updatedAt            DateTime                           @updatedAt @map("updated_at")
  company              Company                            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organisation         Organisation                       @relation("OrganisationGlobalAssumptions", fields: [organisationId], references: [id])
  coaAccount           CoaAccount                         @relation(fields: [coaAccountId], references: [id])
  excludedProperties   GlobalAssumptionExcludedProperty[]

  @@index([companyId])
  @@index([coaAccountId])
  @@index([organisationId])
  @@map("global_assumptions")
}

model GlobalAssumptionExcludedProperty {
  id                 String           @id @default(uuid()) @db.Uuid
  companyId          String           @map("company_id") @db.Uuid
  organisationId     String           @map("organisation_id") @db.Uuid
  globalAssumptionId String           @map("global_assumption_id") @db.Uuid
  propertyId         String           @map("property_id") @db.Uuid
  propertyCode       String?          @map("property_code") @db.VarChar(100)
  propertyName       String?          @map("property_name") @db.VarChar(255)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  globalAssumption   GlobalAssumption @relation(fields: [globalAssumptionId], references: [id], onDelete: Cascade)
  property           Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([globalAssumptionId, propertyId])
  @@index([propertyId])
  @@index([companyId, organisationId])
  @@map("global_assumption_excluded_properties")
}

model BudgetAssumptionApplyState {
  propertyId       String    @map("property_id") @db.Uuid
  fiscalYear       Int       @map("fiscal_year")
  gaCount          Int       @map("ga_count")
  gaMaxUpdatedAt   DateTime? @map("ga_max_updated_at")
  exclCount        Int       @map("excl_count")
  exclMaxUpdatedAt DateTime? @map("excl_max_updated_at")
  lastAppliedAt    DateTime  @default(now()) @map("last_applied_at")
  property         Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, fiscalYear])
  @@map("budget_assumption_apply_state")
}

/// Watermark for load-time budget_calculation runs, so mode 6 (initializeRoutine)
/// executes once per property + fiscal year instead of on every screen load.
model BudgetInitRunState {
  propertyId String   @map("property_id") @db.Uuid
  fiscalYear Int      @map("fiscal_year")
  mode       Int      @map("mode")
  lastRunAt  DateTime @default(now()) @map("last_run_at")
  lastStatus String   @map("last_status") @db.VarChar(16)
  lastError  String?  @map("last_error")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, fiscalYear, mode])
  @@map("budget_init_run_state")
}

model PayrollMethod {
  id                 String                     @id @default(uuid()) @db.Uuid
  companyId          String                     @map("company_id") @db.Uuid
  organisationId     String                     @map("organisation_id") @db.Uuid
  code               String                     @map("code") @db.VarChar(100)
  name               String                     @map("name") @db.VarChar(200)
  valueCount         Int                        @default(1) @map("value_count")
  formula            String?                    @map("formula")
  valueLabel1        String?                    @map("value_label_1") @db.VarChar(100)
  valueLabel2        String?                    @map("value_label_2") @db.VarChar(100)
  isActive           Boolean                    @default(true) @map("is_active")
  sortOrder          Int                        @default(0) @map("sort_order")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  benefitAssumptions PayrollBenefitAssumption[]
  company            Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organisation       Organisation               @relation("OrganisationPayrollMethods", fields: [organisationId], references: [id])

  @@unique([organisationId, code])
  @@index([companyId])
  @@index([organisationId])
  @@index([companyId, isActive])
  @@map("payroll_methods")
}

model PayrollBenefitAssumption {
  id                   String                                     @id @default(uuid()) @db.Uuid
  companyId            String                                     @map("company_id") @db.Uuid
  organisationId       String                                     @map("organisation_id") @db.Uuid
  coaAccountId         String                                     @map("coa_account_id") @db.Uuid
  methodId             String                                     @map("method_id") @db.Uuid
  amount1              Decimal                                    @map("amount_1") @db.Decimal(18, 5)
  amount2              Decimal?                                   @map("amount_2") @db.Decimal(18, 5)
  amount3              Decimal?                                   @map("amount_3") @db.Decimal(18, 5)
  amountConfig         Json?                                      @map("amount_config")
  chargeConfig         Json?                                      @map("charge_config")
  hasMultipleInputLine Boolean                                    @default(false) @map("has_multiple_input_line")
  updatedBy            String?                                    @map("updated_by") @db.VarChar(100)
  createdAt            DateTime                                   @default(now()) @map("created_at")
  updatedAt            DateTime                                   @updatedAt @map("updated_at")
  coaAccount           CoaAccount                                 @relation(fields: [coaAccountId], references: [id])
  company              Company                                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  method               PayrollMethod                              @relation(fields: [methodId], references: [id])
  organisation         Organisation                               @relation("OrganisationPayrollBenefitAssumptions", fields: [organisationId], references: [id])
  excludedProperties   PayrollBenefitAssumptionExcludedProperty[]
  manualDefaults       PayrollBenefitAssumptionManualDefault[]

  @@unique([organisationId, coaAccountId])
  @@index([companyId])
  @@index([organisationId])
  @@index([coaAccountId])
  @@index([methodId])
  @@map("payroll_benefit_assumptions")
}

model PayrollBenefitAssumptionExcludedProperty {
  id                         String                   @id @default(uuid()) @db.Uuid
  companyId                  String                   @map("company_id") @db.Uuid
  organisationId             String                   @map("organisation_id") @db.Uuid
  payrollBenefitAssumptionId String                   @map("payroll_benefit_assumption_id") @db.Uuid
  propertyId                 String                   @map("property_id") @db.Uuid
  propertyCode               String?                  @map("property_code") @db.VarChar(100)
  propertyName               String?                  @map("property_name") @db.VarChar(255)
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")
  payrollBenefitAssumption   PayrollBenefitAssumption @relation(fields: [payrollBenefitAssumptionId], references: [id], onDelete: Cascade)
  property                   Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([payrollBenefitAssumptionId, propertyId])
  @@index([propertyId])
  @@index([companyId, organisationId])
  @@map("payroll_benefit_assumption_excluded_properties")
}

model PayrollBenefitAssumptionManualDefault {
  id                         String                   @id @default(uuid()) @db.Uuid
  companyId                  String                   @map("company_id") @db.Uuid
