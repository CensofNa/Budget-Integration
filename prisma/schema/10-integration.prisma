// Integration config

model IntegrationPlugin {
  id                 String              @id @map("plugin_id") @db.VarChar(100)
  companyId          String              @map("company_id") @db.Uuid
  pluginName         String              @map("plugin_name") @db.VarChar(200)
  version            String              @db.VarChar(50)
  provider           String              @db.VarChar(200)
  sourceKind         String              @map("source_kind") @db.VarChar(100)
  sourceType         String              @map("source_type") @db.VarChar(100)
  manifestJson       Json?               @map("manifest_json")
  isActive           Boolean             @default(true) @map("is_active")
  installedAt        DateTime            @default(now()) @map("installed_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  company            Company             @relation(fields: [companyId], references: [id])
  integrationSources IntegrationSource[]

  @@index([companyId])
  @@index([sourceType])
  @@map("integration_plugins")
}

model IntegrationSource {
  id                   String                    @id @default(uuid()) @db.Uuid
  companyId            String                    @map("company_id") @db.Uuid
  organisationId       String                    @map("organisation_id") @db.Uuid
  pluginId             String                    @map("plugin_id") @db.VarChar(100)
  sourceCode           String                    @map("source_code") @db.VarChar(100)
  sourceName           String                    @map("source_name") @db.VarChar(200)
  sourceKind           String                    @map("source_kind") @db.VarChar(100)
  sourceType           String                    @map("source_type") @db.VarChar(100)
  isPrimary            Boolean                   @default(false) @map("is_primary")
  isActive             Boolean                   @default(true) @map("is_active")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  config               IntegrationSourceConfig?
  entities             IntegrationSourceEntity[]
  company              Company                   @relation(fields: [companyId], references: [id])
  organisation         Organisation              @relation(fields: [organisationId], references: [id])
  plugin               IntegrationPlugin         @relation(fields: [pluginId], references: [id])
  syncRuns             IntegrationSyncRun[]
  sourceRecordMaps     SourceRecordMap[]
  stagingBatches       StagingApiBatch[]
  stagingBudgets       StagingBudget[]
  stagingPropertyUnits StagingPropertyUnit[]
  stagingUnitTypes     StagingUnitType[]

  integrationReportRuns        IntegrationReportRun[]
  integrationReportDefinitions IntegrationReportDefinition[]
  stagingReportDatas           StagingReportData[]
  stagingBudgetActuals         StagingBudgetActual[]
  integrationErrorLogs         IntegrationErrorLog[]
  stagingGlTrees               StagingGlTree[]

  @@unique([companyId, organisationId, sourceCode])
  @@index([companyId])
  @@index([organisationId])
  @@index([pluginId])
  @@index([sourceType])
  @@map("integration_sources")
}

model IntegrationSourceConfig {
  id                  String            @id @default(uuid()) @db.Uuid
  integrationSourceId String            @unique @map("integration_source_id") @db.Uuid
  connectionJson      Json?             @map("connection_json")
  credentialsJson     Json?             @map("credentials_json")
  syncSettingsJson    Json?             @map("sync_settings_json")
  mappingProfileJson  Json?             @map("mapping_profile_json")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  integrationSource   IntegrationSource @relation(fields: [integrationSourceId], references: [id], onDelete: Cascade)

  @@map("integration_source_configs")
}

model IntegrationSourceEntity {
  id                  String            @id @default(uuid()) @db.Uuid
  integrationSourceId String            @map("integration_source_id") @db.Uuid
  entityName          String            @map("entity_name") @db.VarChar(100)
  isEnabled           Boolean           @default(true) @map("is_enabled")
  syncMode            String            @default("incremental") @map("sync_mode") @db.VarChar(50)
  isAuthoritative     Boolean           @default(false) @map("is_authoritative")
  priorityOrder       Int               @default(1) @map("priority_order")
  syncSettingsJson    Json?             @map("sync_settings_json")
  mappingProfileJson  Json?             @map("mapping_profile_json")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  integrationSource   IntegrationSource @relation(fields: [integrationSourceId], references: [id], onDelete: Cascade)

  @@unique([integrationSourceId, entityName])
  @@index([integrationSourceId])
  @@index([entityName])
  @@index([isEnabled])
  @@map("integration_source_entities")
}

model IntegrationReportDefinition {
  id String @id @default(uuid()) @db.Uuid

  companyId           String @map("company_id") @db.Uuid
  organisationId      String @map("organisation_id") @db.Uuid
  integrationSourceId String @map("integration_source_id") @db.Uuid

  reportCode  String  @map("report_code") @db.VarChar(150)
  reportName  String  @map("report_name") @db.VarChar(150)
  displayName String  @map("display_name") @db.VarChar(250)
  description String? @db.Text

  reportVersion String? @map("report_version") @db.VarChar(50)
  methodVersion String? @map("method_version") @db.VarChar(50)

  entityName String @default("ReportData") @map("entity_name") @db.VarChar(100)

  endpointPath String @default("reports") @map("endpoint_path") @db.VarChar(100)
  methodName   String @default("getReportData") @map("method_name") @db.VarChar(100)

  paramsSchemaJson    Json? @map("params_schema_json")
  defaultParamsJson   Json? @map("default_params_json")
  sourceKeyFieldsJson Json? @map("source_key_fields_json")
  syncSettingsJson    Json? @map("sync_settings_json")

  isSystemDefined Boolean @default(true) @map("is_system_defined")
  isCustomReport  Boolean @default(false) @map("is_custom_report")
  isEnabled       Boolean @default(true) @map("is_enabled")

  effectiveFrom DateTime? @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company           Company           @relation(fields: [companyId], references: [id])
  organisation      Organisation      @relation(fields: [organisationId], references: [id])
  integrationSource IntegrationSource @relation(fields: [integrationSourceId], references: [id])

  runs IntegrationReportRun[]

  @@unique([integrationSourceId, reportCode])
  @@index([companyId])
  @@index([organisationId])
  @@index([integrationSourceId])
  @@index([reportCode])
  @@index([isEnabled])
  @@map("integration_report_definitions")
}

model IntegrationReportRun {
  id String @id @default(uuid()) @db.Uuid

  companyId           String @map("company_id") @db.Uuid
  organisationId      String @map("organisation_id") @db.Uuid
  integrationSourceId String @map("integration_source_id") @db.Uuid
  reportDefinitionId  String @map("report_definition_id") @db.Uuid
  syncRunId           String @map("sync_run_id") @db.Uuid

  reportCode    String  @map("report_code") @db.VarChar(150)
  reportName    String  @map("report_name") @db.VarChar(150)
  reportVersion String? @map("report_version") @db.VarChar(50)
  methodVersion String? @map("method_version") @db.VarChar(50)

  requestParamsJson   Json  @map("request_params_json")
  responseSummaryJson Json? @map("response_summary_json")

  status             String @default("STARTED") @db.VarChar(50)
  rowCount           Int    @default(0) @map("row_count")
  recordsStaged      Int    @default(0) @map("records_staged")
  recordsTransformed Int    @default(0) @map("records_transformed")
  recordsFailed      Int    @default(0) @map("records_failed")

  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  errorMessage String?   @map("error_message") @db.Text

  company           Company                     @relation(fields: [companyId], references: [id])
  organisation      Organisation                @relation(fields: [organisationId], references: [id])
  integrationSource IntegrationSource           @relation(fields: [integrationSourceId], references: [id])
  reportDefinition  IntegrationReportDefinition @relation(fields: [reportDefinitionId], references: [id])
  syncRun           IntegrationSyncRun          @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([organisationId])
  @@index([integrationSourceId])
  @@index([reportDefinitionId])
  @@index([syncRunId])
  @@index([reportCode])
  @@index([status])
  @@map("integration_report_runs")
}

model IntegrationQueueJob {
  id                  String  @id @default(uuid()) @db.Uuid
  companyId           String  @map("company_id") @db.Uuid
  organisationId      String  @map("organisation_id") @db.Uuid
  integrationSourceId String? @map("integration_source_id") @db.Uuid
  syncRunId           String? @map("sync_run_id") @db.Uuid
  stagingBatchId      String? @map("staging_batch_id") @db.Uuid

  queueName  String  @map("queue_name") @db.VarChar(100)
  jobName    String  @map("job_name") @db.VarChar(100)
  bullJobId  String? @map("bull_job_id") @db.VarChar(150)
  entityName String? @map("entity_name") @db.VarChar(100)
  status     String  @default("QUEUED") @db.VarChar(50)

  payloadJson  Json?   @map("payload_json")
  errorMessage String? @map("error_message") @db.Text

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([organisationId])
  @@index([integrationSourceId])
  @@index([queueName])
  @@index([status])
  @@index([bullJobId])
  @@map("integration_queue_jobs")
}

model IntegrationErrorLog {
  id String @id @default(uuid()) @db.Uuid

  companyId           String  @map("company_id") @db.Uuid
  organisationId      String  @map("organisation_id") @db.Uuid
  integrationSourceId String? @map("integration_source_id") @db.Uuid
  syncRunId           String? @map("sync_run_id") @db.Uuid

  entityName String? @map("entity_name") @db.VarChar(100)
  queueName  String? @map("queue_name") @db.VarChar(150)
  jobName    String? @map("job_name") @db.VarChar(150)
  bullJobId  String? @map("bull_job_id") @db.VarChar(150)

  errorCode     String  @map("error_code") @db.VarChar(150)
  errorMessage  String  @map("error_message")
  errorCategory String  @map("error_category") @db.VarChar(100)
  severity      String  @default("ERROR") @db.VarChar(50)
  isRetryable   Boolean @default(false) @map("is_retryable")

  contextJson Json?   @map("context_json")
  stackTrace  String? @map("stack_trace")

  occurredAt DateTime @default(now()) @map("occurred_at")

  company           Company             @relation(fields: [companyId], references: [id])
  organisation      Organisation        @relation(fields: [organisationId], references: [id])
  integrationSource IntegrationSource?  @relation(fields: [integrationSourceId], references: [id])
  syncRun           IntegrationSyncRun? @relation(fields: [syncRunId], references: [id])

  @@index([companyId, occurredAt])
  @@index([organisationId, occurredAt])
  @@index([integrationSourceId, errorCode])
  @@index([syncRunId])
  @@index([entityName])
  @@index([errorCategory])
  @@map("integration_error_logs")
}

model IntegrationLog {
  id String @id @default(uuid()) @db.Uuid

  service String @db.VarChar(100)
  level   String @db.VarChar(20)
  message String @db.Text

  companyId           String? @map("company_id") @db.Uuid
  organisationId      String? @map("organisation_id") @db.Uuid
  integrationSourceId String? @map("integration_source_id") @db.Uuid
  syncRunId           String? @map("sync_run_id") @db.Uuid
  jobId               String? @map("job_id") @db.VarChar(150)
  queueName           String? @map("queue_name") @db.VarChar(150)

  entityName String? @map("entity_name") @db.VarChar(100)
  action     String? @map("action") @db.VarChar(100)

  contextJson Json?   @map("context_json")
  errorStack  String? @map("error_stack") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  @@index([service, createdAt])
  @@index([level, createdAt])
  @@index([companyId, createdAt])
  @@index([entityName, createdAt])
  @@index([syncRunId])
  @@index([createdAt])
  @@map("integration_logs")
}

model StagingApiBatch {
  id String @id @default(uuid()) @db.Uuid

  companyId           String @map("company_id") @db.Uuid
  organisationId      String @map("organisation_id") @db.Uuid
  integrationSourceId String @map("integration_source_id") @db.Uuid
  syncRunId           String @map("sync_run_id") @db.Uuid

  entityName   String  @map("entity_name") @db.VarChar(100)
  sourceMethod String? @map("source_method") @db.VarChar(150)

  requestId    String? @map("request_id") @db.VarChar(150)
  responseCode Int?    @map("response_code")

  rawRequest  Json? @map("raw_request")
  rawResponse Json? @map("raw_response")

  status String @default("RECEIVED") @db.VarChar(50)
  // RECEIVED, PARSED, FAILED

  errorMessage String? @map("error_message") @db.Text

  receivedAt DateTime @default(now()) @map("received_at")

  company           Company            @relation(fields: [companyId], references: [id])
  organisation      Organisation       @relation(fields: [organisationId], references: [id])
  integrationSource IntegrationSource  @relation(fields: [integrationSourceId], references: [id])
  syncRun           IntegrationSyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  stagingProperties    StagingProperty[]
  stagingPropertyUnits StagingPropertyUnit[]
  stagingUnitTypes     StagingUnitType[]
  stagingBudgets       StagingBudget[]

  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  stagingReportDatas StagingReportData[]
  stagingGlTrees     StagingGlTree[]

  @@index([companyId])
  @@index([organisationId])
  @@index([integrationSourceId])
  @@index([syncRunId])
  @@index([entityName])
  @@index([status])
  @@map("staging_api_batches")
}

model StagingProperty {
  id                   String              @id @default(uuid()) @db.Uuid
  companyId            String              @map("company_id") @db.Uuid
  organisationId       String              @map("organisation_id") @db.Uuid
  integrationSourceId  String              @map("integration_source_id") @db.Uuid
  syncRunId            String              @map("sync_run_id") @db.Uuid
  stagingBatchId       String              @map("staging_batch_id") @db.Uuid
  sourceRecordId       String?             @map("source_record_id") @db.VarChar(150)
  parentSourceRecordId String?             @map("parent_source_record_id") @db.VarChar(150)
  propertyCode         String?             @map("property_code") @db.VarChar(100)
  propertyName         String?             @map("property_name") @db.VarChar(255)
  propertyType         String?             @map("property_type") @db.VarChar(100)
  rawPropertyPayload   Json                @map("raw_property_payload")
  validationStatus     String              @default("PENDING") @map("validation_status") @db.VarChar(50)
  transformStatus      String              @default("PENDING") @map("transform_status") @db.VarChar(50)
  validationErrors     Json?               @map("validation_errors")
  transformErrors      Json?               @map("transform_errors")
  sourceHash           String?             @map("source_hash") @db.VarChar(200)
  stagedAt             DateTime            @default(now()) @map("staged_at")
  transformedAt        DateTime?           @map("transformed_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  company              Company             @relation(fields: [companyId], references: [id])
  organisation         Organisation        @relation(fields: [organisationId], references: [id])
  stagingBatch         StagingApiBatch     @relation(fields: [stagingBatchId], references: [id], onDelete: Cascade)
  propertyGlAccounts   PropertyGlAccount[]

  @@index([companyId])
  @@index([organisationId])
  @@index([integrationSourceId])
  @@index([syncRunId])
  @@index([stagingBatchId])
  @@index([sourceRecordId])
  @@index([validationStatus])
  @@index([transformStatus])
  @@index([sourceHash])
  @@map("staging_properties")
}

model StagingPropertyUnit {
  id                  String             @id @default(uuid()) @db.Uuid
  companyId           String             @map("company_id") @db.Uuid
  organisationId      String             @map("organisation_id") @db.Uuid
  integrationSourceId String             @map("integration_source_id") @db.Uuid
  syncRunId           String             @map("sync_run_id") @db.Uuid
  stagingBatchId      String             @map("staging_batch_id") @db.Uuid
  sourcePropertyId    String?            @map("source_property_id") @db.VarChar(150)
  sourceUnitId        String?            @map("source_unit_id") @db.VarChar(150)
  remotePrimaryKey    String?            @map("remote_primary_key") @db.VarChar(300)
  unitNumber          String?            @map("unit_number") @db.VarChar(100)
  floorPlanName       String?            @map("floorplan_name") @db.VarChar(150)
  unitTypeName        String?            @map("unit_type_name") @db.VarChar(150)
  sourceHash          String?            @map("source_hash") @db.VarChar(200)
  rawUnitPayload      Json               @map("raw_unit_payload")
  validationStatus    String             @default("PENDING") @map("validation_status") @db.VarChar(50)
  transformStatus     String             @default("PENDING") @map("transform_status") @db.VarChar(50)
  validationErrors    Json?              @map("validation_errors")
  transformErrors     Json?              @map("transform_errors")
  stagedAt            DateTime           @default(now()) @map("staged_at")
  transformedAt       DateTime?          @map("transformed_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  company             Company            @relation(fields: [companyId], references: [id])
  integrationSource   IntegrationSource  @relation(fields: [integrationSourceId], references: [id])
  organisation        Organisation       @relation(fields: [organisationId], references: [id])
  stagingBatch        StagingApiBatch    @relation(fields: [stagingBatchId], references: [id], onDelete: Cascade)
  syncRun             IntegrationSyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([organisationId])
  @@index([integrationSourceId])
  @@index([syncRunId])
  @@index([stagingBatchId])
  @@index([sourcePropertyId])
  @@index([sourceUnitId])
  @@index([remotePrimaryKey])
  @@index([sourceHash])
  @@index([validationStatus])
  @@index([transformStatus])
  @@map("staging_property_units")
}

