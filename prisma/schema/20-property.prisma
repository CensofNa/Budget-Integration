  mtdActual          Decimal? @map("mtd_actual") @db.Decimal(18, 2)
  mtdBudget          Decimal? @map("mtd_budget") @db.Decimal(18, 2)
  mtdVariance        Decimal? @map("mtd_variance") @db.Decimal(18, 2)
  mtdVariancePercent Decimal? @map("mtd_variance_percent") @db.Decimal(18, 6)

  ytdActual          Decimal? @map("ytd_actual") @db.Decimal(18, 2)
  ytdBudget          Decimal? @map("ytd_budget") @db.Decimal(18, 2)
  ytdVariance        Decimal? @map("ytd_variance") @db.Decimal(18, 2)
  ytdVariancePercent Decimal? @map("ytd_variance_percent") @db.Decimal(18, 6)

  annualBudget Decimal? @map("annual_budget") @db.Decimal(18, 2)

  sourcePropertyId  String? @map("source_property_id") @db.VarChar(100)
  sourceBudgetId    String? @map("source_budget_id") @db.VarChar(100)
  sourceGlTreeId    String? @map("source_gl_tree_id") @db.VarChar(100)
  sourceGlAccountId String? @map("source_gl_account_id") @db.VarChar(100)

  sourceHash   String?   @map("source_hash") @db.VarChar(200)
  lastSyncedAt DateTime? @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company             Company                 @relation(fields: [companyId], references: [id])
  organisation        Organisation            @relation(fields: [organisationId], references: [id])
  property            Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  budget              PropertyBudget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  glTree              GlTree?                 @relation(fields: [glTreeId], references: [id], onDelete: Cascade)
  glAccount           GlAccount?              @relation(fields: [glAccountId], references: [id], onDelete: Cascade)
  propertyGlAccount   PropertyGlAccount?      @relation(fields: [propertyGlAccountId], references: [id])
  propertyGlAccountId String?                 @db.Uuid
  budgetGlAccount     PropertyBudgetGlAccount @relation(fields: [budgetGlAccountId], references: [id], onDelete: Cascade)

