  @@unique([companyId, organisationId, propertyId, budgetId, budgetGlAccountId, postMonth, accountingMethod])
  @@index([propertyId])
  @@index([budgetId])
  @@index([glTreeId])
  @@index([glAccountId])
  @@index([postMonth])
  @@index([fiscalYear])
  @@map("property_budget_actuals")
}

