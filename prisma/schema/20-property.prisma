model PropertyExternalSnapshot {
  id                      String                      @id @default(uuid()) @map("id") @db.Uuid
  propertyId              String                      @unique @map("property_id") @db.Uuid
  provider                IntegrationProvider         @default(ENTRATA) @map("provider")
  externalPropertyId      BigInt?                     @unique @map("external_property_id")
  propertyName            String?                     @map("property_name") @db.VarChar(255)
  currencyCode            String?                     @map("currency_code") @db.VarChar(10)
  buildingCount           Int?                        @map("building_count")
  unitCount               Int?                        @map("unit_count")
  propertyAvailabilityUrl String?                     @map("property_availability_url") @db.VarChar(1000)
  lastSyncedAt            DateTime?                   @map("last_synced_at")
  rawPayload              Json?                       @map("raw_payload") @db.Json
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  pets                    PropertyExternalPetPolicy[]
  property                Property                    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  units                   PropertyUnit[]

  @@unique([propertyId, externalPropertyId])
  @@index([provider])
  @@map("property_external_snapshots")
}

model PropertyExternalPetPolicy {
