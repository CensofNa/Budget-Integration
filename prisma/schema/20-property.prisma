model Property {
  id                                  String                                        @id @default(uuid()) @db.Uuid
  companyId                           String                                        @map("company_id") @db.Uuid
  organisationId                      String                                        @map("organisation_id") @db.Uuid
  workflowDefinitionId                String?                                       @db.Uuid
  code                                String?                                       @map("property_code") @db.VarChar(100)
  name                                String?                                       @map("property_name") @db.VarChar(255)
  type                                String?                                       @map("property_type") @db.VarChar(100)
  ownerName                           String?                                       @map("owner_name") @db.VarChar(255)
  status                              PropertyStatus                                @default(DRAFT)
  operatingType                       PropertyOperatingType?                        @map("property_operating_type")
  budgetYear                          Int?
  budgetYearType                      PropertyBudgetYearType?                       @map("budget_year_type")
  fiscalYearStartMonth                Int?                                          @map("fiscal_year_start_month")
  fiscalYearEndMonth                  Int?                                          @map("fiscal_year_end_month")
  fiscalYearStartDate                 DateTime?                                     @map("fiscal_year_start_date")
  fiscalYearEndDate                   DateTime?                                     @map("fiscal_year_end_date")
  reforecastLockedTillMonth           Int?                                          @map("reforecast_locked_till_month")
  externalId                          Int?                                          @unique
  marketingName                       String?
  yearBuilt                           Int?                                          @map("year_built")
  website                             String?                                       @db.VarChar(500)
  shortDescription                    String?                                       @map("short_description")
  longDescription                     String?                                       @map("long_description")
  isDisabled                          Boolean                                       @default(false) @map("is_disabled")
  isFeatured                          Boolean                                       @default(false) @map("is_featured")
  isWorkflowDeployed                  Boolean                                       @default(false)
  createdSource                       String?                                       @map("created_source") @db.VarChar(100)
  updatedSource                       String?                                       @map("updated_source") @db.VarChar(100)
  lastSyncedAt                        DateTime?                                     @map("last_synced_at")
  isManuallyOverridden                Boolean                                       @default(false) @map("is_manually_overridden")
  createdAt                           DateTime                                      @default(now()) @map("created_at")
  updatedAt                           DateTime                                      @updatedAt @map("updated_at")
  createdBy                           String?                                       @map("created_by") @db.Uuid
  updatedBy                           String?                                       @map("updated_by") @db.Uuid
  propertyManagerId                   String?                                       @map("property_manager_id") @db.Uuid
  currentWorkflowStepId               String?                                       @map("current_workflow_step_id") @db.Uuid
  assignedToUserId                    String?                                       @map("assigned_to_user_id") @db.Uuid
  externalSnapshot                    PropertyExternalSnapshot?
  leaseTerms                          PropertyLeaseTerm[]
  address                             PropertyMainAddress?
  auditLogs                           AuditLog[]
  businessRoleAssignments             BusinessRoleAssignment[]
  company                             Company                                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organisation                        Organisation                                  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  propertyManager                     User?                                         @relation("PropertyManager", fields: [propertyManagerId], references: [id])
  workflowDefinition                  WorkflowDefinition?                           @relation(fields: [workflowDefinitionId], references: [id])
  addresses                           PropertyAddress[]
  budgets                             PropertyBudget[]
  officeHours                         PropertyOfficeHour[]
  postMonths                          PropertyPostMonth?
  spaceOptions                        PropertySpaceOption[]
  unitTypes                           PropertyUnitType[]
  units                               PropertyUnit[]
  workflowAssignments                 PropertyWorkflowAssignment[]
  workflowComments                    PropertyWorkflowComment[]
  systemRoleAssignments               SystemRoleAssignment[]
  occupancyReforecasts                OccupancyReforecast[]
  isWorkflowCompleted                 Boolean                                       @default(false)
  currentWorkflowStep                 WorkflowStep?                                 @relation("PropertyCurrentWorkflowStep", fields: [currentWorkflowStepId], references: [id])
  assignedToUser                      User?                                         @relation("PropertyAssignedToUser", fields: [assignedToUserId], references: [id])
  reassignments                       PropertyReassignment[]                        @relation("PropertyReassignments")
  marketRentUnitRates                 MarketRentUnitRate[]
  marketRentChangeSets                MarketRentChangeSet[]
  marketRentUnitChanges               MarketRentUnitChange[]
  leaseUpUnits                        LeaseUpUnit[]
  rehabUnits                          RehabUnit[]
  nonIncomeUnits                      NonIncomeUnit[]
  propertyGlTrees                     PropertyGlTree[]
  propertyBudgetActuals               PropertyBudgetActual[]
  propertyGlAccounts                  PropertyGlAccount[]
  coaPropertyExclusions               CoaPropertyExclusion[]
  coaTemplateId                       String?                                       @map("coa_template_id") @db.Uuid
  coaTemplate                         CoaTemplate?                                  @relation(fields: [coaTemplateId], references: [id], onDelete: SetNull)
  globalAssumptionExclusions          GlobalAssumptionExcludedProperty[]
  budgetAssumptionApplyStates         BudgetAssumptionApplyState[]
  budgetInitRunStates                 BudgetInitRunState[]
  payrollBenefitAssumptionExclusions  PayrollBenefitAssumptionExcludedProperty[]
  payrollGlobalAssumptionExclusions   PayrollGlobalAssumptionExcludedProperty[]
  payrollPositionAssumptionExclusions PayrollPositionAssumptionExcludedProperty[]
  overtimeExclusions                  OvertimeExcludedProperty[]
  proformaScenarios                   ProformaScenario[]
  proformaDrivers                     ProformaDriver[]
  proformaGlobalAssumptions           ProformaGlobalAssumption[]
  proformaCoaGaExcludedProperties     ProformaCoaGlobalAssumptionExcludedProperty[]
  assignedSystemRoles                 SystemRoleProperty[]
  statusHistory                       PropertyStatusHistory[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([organisationId])
  @@index([name])
  @@index([status])
  @@index([companyId, organisationId, status])
  @@index([assignedToUserId])
  @@index([propertyManagerId])
  @@index([currentWorkflowStepId])
  @@map("properties")
}

model PropertyMainAddress {
  id         String   @id @default(uuid()) @map("id") @db.Uuid
  propertyId String   @unique @map("property_id") @db.Uuid
  address    String   @map("address") @db.VarChar(500)
  city       String   @map("city")
  state      String   @map("state")
  postalCode String   @map("postal_code")
  country    String   @map("country")
  email      String?  @map("email") @db.VarChar(255)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([id])
  @@map("property_main_addresses")
}

model PropertyAddress {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  organisationId    String   @map("organisation_id") @db.Uuid
  propertyId        String   @map("property_id") @db.Uuid
  sourceAddressType String?  @map("source_address_type") @db.VarChar(100)
  addressType       String?  @map("address_type") @db.VarChar(100)
  addressLine1      String?  @map("address_line1") @db.VarChar(255)
  addressLine2      String?  @map("address_line2") @db.VarChar(255)
  city              String?  @db.VarChar(100)
  state             String?  @db.VarChar(100)
  stateCode         String?  @map("state_code") @db.VarChar(50)
  province          String?  @db.VarChar(100)
  postalCode        String?  @map("postal_code") @db.VarChar(30)
  country           String?  @db.VarChar(100)
  email             String?  @db.VarChar(255)
