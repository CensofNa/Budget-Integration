  snapshot    PropertyExternalSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@map("property_external_pet_policies")
}

model PropertyUnit {
  id                   String                    @id @default(uuid()) @db.Uuid
  companyId            String                    @map("company_id") @db.Uuid
  organisationId       String                    @map("organisation_id") @db.Uuid
  propertyId           String                    @map("property_id") @db.Uuid
  snapshotId           String?                   @db.Uuid
  externalUnitId       BigInt?
  remotePrimaryKey     String?                   @map("remote_primary_key") @db.VarChar(300)
  unitNumber           String?                   @map("unit_number") @db.VarChar(100)
  sourceUnitId         String?                   @map("source_unit_id") @db.VarChar(150)
  unitTypeId           String?                   @map("unit_type_id") @db.VarChar(150)
  unitTypeName         String?                   @map("unit_type_name") @db.VarChar(150)
  floorPlanId          String?                   @map("floorplan_id") @db.VarChar(150)
  floorplanName        String?                   @map("floorplan_name") @db.VarChar(150)
  buildingId           String?                   @map("building_id") @db.VarChar(150)
  buildingName         String?                   @map("building_name") @db.VarChar(150)
  floorId              String?                   @map("floor_id") @db.VarChar(150)
  floorNumber          String?                   @map("floor_number") @db.VarChar(50)
  bedrooms             Int?                      @map("bedrooms")
  bathrooms            Int?                      @map("bathrooms")
  squareFeet           Int?                      @map("square_feet")
  maxOccupants         Int?                      @map("max_occupants")
  maxPets              Int?                      @map("max_pets")
  isCorporateRented    Boolean?                  @map("is_corporate_rented")
  isFurnished          Boolean?                  @map("is_furnished")
  createdSource        String?                   @map("created_source") @db.VarChar(100)
  updatedSource        String?                   @map("updated_source") @db.VarChar(100)
  lastSyncedAt         DateTime?                 @map("last_synced_at")
  isManuallyOverridden Boolean                   @default(false) @map("is_manually_overridden")
  city                 String?
  state                String?
  postalCode           String?
  country              String?
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  address              PropertyUnitAddress?
  spaces               PropertyUnitSpace[]
  company              Company                   @relation(fields: [companyId], references: [id])
  organisation         Organisation              @relation(fields: [organisationId], references: [id])
  property             Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  snapshot             PropertyExternalSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  nonIncomeUnits       NonIncomeUnit[]

  @@unique([companyId, organisationId, propertyId, buildingId, unitNumber])
  @@index([companyId])
  @@index([organisationId])
  @@index([propertyId])
  @@index([sourceUnitId])
  @@index([remotePrimaryKey])
  @@index([unitNumber])
  @@index([snapshotId])
  @@index([externalUnitId])
  @@map("property_units")
}

