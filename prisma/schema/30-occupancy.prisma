  effectiveRent    Decimal? @map("effective_rent") @db.Decimal(18, 6)
  actualRent       Decimal? @map("actual_rent") @db.Decimal(18, 6)

  moveIns      Decimal? @map("move_ins") @db.Decimal(18, 4)
  mtmStarted   Decimal? @map("mtm_started") @db.Decimal(18, 4)
  mtmConverted Decimal? @map("mtm_converted") @db.Decimal(18, 4)

  renewalApplicationCompletions Decimal? @map("renewal_application_completions") @db.Decimal(18, 4)
  renewalLeaseApprovals         Decimal? @map("renewal_lease_approvals") @db.Decimal(18, 4)
  renewalLeaseCreations         Decimal? @map("renewal_lease_creations") @db.Decimal(18, 4)

  transfersCompleted Decimal? @map("transfers_completed") @db.Decimal(18, 4)
  notices            Decimal? @db.Decimal(18, 4)
  moveOuts           Decimal? @map("move_outs") @db.Decimal(18, 4)
  renewals           Decimal? @db.Decimal(18, 4)
  renewalTransfers   Decimal? @map("renewal_transfers") @db.Decimal(18, 4)
  skips              Decimal? @db.Decimal(18, 4)
  leasesExpiring     Decimal? @map("leases_expiring") @db.Decimal(18, 4)
  evictionsCompleted Decimal? @map("evictions_completed") @db.Decimal(18, 4)
  leasesApproved     Decimal? @map("leases_approved") @db.Decimal(18, 4)

  cloLeads        Decimal? @map("clo_leads") @db.Decimal(18, 4)
  newLeads        Decimal? @map("new_leads") @db.Decimal(18, 4)
  email           Decimal? @db.Decimal(18, 4)
  call            Decimal? @db.Decimal(18, 4)
  online          Decimal? @db.Decimal(18, 4)
  referredContact Decimal? @map("referred_contact") @db.Decimal(18, 4)
  visitTour       Decimal? @map("visit_tour") @db.Decimal(18, 4)
  offsite         Decimal? @db.Decimal(18, 4)
  chat            Decimal? @db.Decimal(18, 4)
  text            Decimal? @db.Decimal(18, 4)
  other           Decimal? @db.Decimal(18, 4)

  leadEmail Decimal? @map("lead_email") @db.Decimal(18, 4)
  leadCall  Decimal? @map("lead_call") @db.Decimal(18, 4)
  leadChat  Decimal? @map("lead_chat") @db.Decimal(18, 4)
  leadText  Decimal? @map("lead_text") @db.Decimal(18, 4)

  uniqueVisitsTours Decimal? @map("unique_visits_tours") @db.Decimal(18, 4)
  onsiteVisit       Decimal? @map("onsite_visit") @db.Decimal(18, 4)
  unitTour          Decimal? @map("unit_tour") @db.Decimal(18, 4)
  propertyTour      Decimal? @map("property_tour") @db.Decimal(18, 4)
  selfGuidedTour    Decimal? @map("self_guided_tour") @db.Decimal(18, 4)
  virtualTour       Decimal? @map("virtual_tour") @db.Decimal(18, 4)

  prospectsCancelled             Decimal? @map("prospects_cancelled") @db.Decimal(18, 4)
  started                        Decimal? @db.Decimal(18, 4)
  applicationsPartiallyCompleted Decimal? @map("applications_partially_completed") @db.Decimal(18, 4)
  completed                      Decimal? @db.Decimal(18, 4)
  completedCancelled             Decimal? @map("completed_cancelled") @db.Decimal(18, 4)
  denied                         Decimal? @db.Decimal(18, 4)
  approved                       Decimal? @db.Decimal(18, 4)
  approvedCancelled              Decimal? @map("approved_cancelled") @db.Decimal(18, 4)
  leaseCompleted                 Decimal? @map("lease_completed") @db.Decimal(18, 4)
  leaseCompletedCancelled        Decimal? @map("lease_completed_cancelled") @db.Decimal(18, 4)
  abandoned                      Decimal? @db.Decimal(18, 4)
  leaseApproved                  Decimal? @map("lease_approved") @db.Decimal(18, 4)

  readyVacantRented      Decimal? @map("ready_vacant_rented") @db.Decimal(18, 4)
  readyVacantUnrented    Decimal? @map("ready_vacant_unrented") @db.Decimal(18, 4)
  readyTotal             Decimal? @map("ready_total") @db.Decimal(18, 4)
  notReadyVacantRented   Decimal? @map("not_ready_vacant_rented") @db.Decimal(18, 4)
  notReadyVacantUnrented Decimal? @map("not_ready_vacant_unrented") @db.Decimal(18, 4)
  notReadyTotal          Decimal? @map("not_ready_total") @db.Decimal(18, 4)
  makeReadySummaryTotal  Decimal? @map("make_ready_summary_total") @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  @@unique([companyId, organisationId, propertyId, fiscalYear, reportMonth, summarizeBy], map: "property_box_score_monthly_unique")
  @@index([companyId, organisationId, propertyId, fiscalYear])
  @@index([propertyId, fiscalYear])
  @@index([propertyCode])
  @@index([reportMonth])
  @@map("property_box_score_monthly")
}

