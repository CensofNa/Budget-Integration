  ntv           Decimal? @db.Decimal(18, 4)
  ntvPercentage Decimal? @map("ntv_percentage") @db.Decimal(18, 8)

  renewals          Decimal? @db.Decimal(18, 4)
  renewalPercentage Decimal? @map("renewal_percentage") @db.Decimal(18, 8)

  renewalTransfers           Decimal? @map("renewal_transfers") @db.Decimal(18, 4)
  renewalTransfersPercentage Decimal? @map("renewal_transfers_percentage") @db.Decimal(18, 8)

  transfers           Decimal? @db.Decimal(18, 4)
  transfersPercentage Decimal? @map("transfers_percentage") @db.Decimal(18, 8)

  pending           Decimal? @db.Decimal(18, 4)
