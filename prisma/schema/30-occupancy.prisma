  noticeRentedUnits     Decimal? @map("notice_rented_units") @db.Decimal(18, 4)
  noticeUnrentedUnits   Decimal? @map("notice_unrented_units") @db.Decimal(18, 4)
  vacantRentedUnits     Decimal? @map("vacant_rented_units") @db.Decimal(18, 4)
  vacantUnrentedUnits   Decimal? @map("vacant_unrented_units") @db.Decimal(18, 4)

  percentOccupied          Decimal? @map("percent_occupied") @db.Decimal(18, 8)
  percentLeased            Decimal? @map("percent_leased") @db.Decimal(18, 8)
  avgNotExposedLeasedUnits Decimal? @map("avg_not_exposed_leased_units") @db.Decimal(18, 8)
  avgExposure              Decimal? @map("avg_exposure") @db.Decimal(18, 8)

  avgSquareFeet    Decimal? @map("avg_square_feet") @db.Decimal(18, 6)
  avgMarketRent    Decimal? @map("avg_market_rent") @db.Decimal(18, 6)
  scheduledRent    Decimal? @map("scheduled_rent") @db.Decimal(18, 6)
