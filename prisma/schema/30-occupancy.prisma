  reportMonth DateTime @map("report_month") @db.Date

  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end") @db.Date

  months    String? @db.VarChar(50)
  unitType  String? @map("unit_type") @db.VarChar(255)
  floorPlan String? @map("floor_plan") @db.VarChar(255)

  units              Decimal? @db.Decimal(18, 4)
