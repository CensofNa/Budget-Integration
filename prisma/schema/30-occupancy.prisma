model OccupancyPreviousYear {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  budgetYear Int    @map("budget_year")

  lyDecOccupancyUnits        Decimal @default(0) @map("ly_dec_occupancy_units") @db.Decimal(18, 4)
  defaultLyDecOccupancyUnits Decimal @default(0) @map("default_ly_dec_occupancy_units") @db.Decimal(18, 4)

  cyOccupiedUnits      Decimal @default(0) @map("cy_occupied_units") @db.Decimal(18, 4)
  cyTotalUnits         Decimal @default(0) @map("cy_total_units") @db.Decimal(18, 4)
  cyTotalRentableUnits Decimal @default(0) @map("cy_total_rentable_units") @db.Decimal(18, 4)

  source       String?
  isOverridden Boolean @default(false) @map("is_overridden")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([propertyId, budgetYear], map: "uq_occupancy_previous_year_property_budget_year")
  @@map("occupancy_previous_year")
}

model OccupancyMaster {
  id              String  @id @db.Uuid
  groupName       String  @map("group_name")
  descriptionName String  @map("description_name")
  isEditable      Boolean @default(false) @map("is_Editable")

  details OccupancyTransactionDetail[]

  @@map("occupancy_master")
}

model OccupancyTransaction {
  id         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String?                      @map("property_id") @db.Uuid
  budgetYear String                       @map("budget_year")
  createdAt  DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                     @default(now()) @map("updated_at") @db.Timestamptz(6)
  details    OccupancyTransactionDetail[]

  @@unique([propertyId, budgetYear], map: "uq_occupancy_transaction_property_budget_year")
  @@map("occupancy_transaction")
}

model OccupancyTransactionDetail {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  method                 String?
  inputValue             Decimal?              @map("input_value") @db.Decimal(18, 4)
  pct                    Decimal?              @db.Decimal(9, 4)
  jan                    Decimal?              @db.Decimal(18, 4)
  feb                    Decimal?              @db.Decimal(18, 4)
  mar                    Decimal?              @db.Decimal(18, 4)
  apr                    Decimal?              @db.Decimal(18, 4)
  may                    Decimal?              @db.Decimal(18, 4)
  jun                    Decimal?              @db.Decimal(18, 4)
  jul                    Decimal?              @db.Decimal(18, 4)
  aug                    Decimal?              @db.Decimal(18, 4)
  sep                    Decimal?              @db.Decimal(18, 4)
  oct                    Decimal?              @db.Decimal(18, 4)
  nov                    Decimal?              @db.Decimal(18, 4)
  dec                    Decimal?              @map("dec") @db.Decimal(18, 4)
  fullYear               Decimal?              @map("full_year") @db.Decimal(18, 4)
  occupancyTransactionId String?               @map("occupancy_transaction_id") @db.Uuid
  occupancyMasterId      String?               @map("occupancy_master_id") @db.Uuid
  transaction            OccupancyTransaction? @relation(fields: [occupancyTransactionId], references: [id])
  master                 OccupancyMaster?      @relation(fields: [occupancyMasterId], references: [id])

  @@unique([occupancyTransactionId, occupancyMasterId], map: "occupancy_transaction_detail_unique")
  @@map("occupancy_transaction_detail")
}

model OccupancyReforecast {
  id                  String   @id @default(uuid()) @db.Uuid
  propertyId          String   @map("property_id") @db.Uuid
  year                Int      @map("year")
  totalUnits          Int      @map("total_units")
  totalRentableSqFt   Float    @map("total_rentable_sq_ft")
  startingGpr         Float    @map("starting_gpr")
  startingLossToLease Float    @map("starting_loss_to_lease")
  averageMonthlyRent  Float    @default(0) @map("average_monthly_rent")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  property Property                    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  details  OccupancyReforecastDetail[]

  @@unique([propertyId, year])
  @@map("occupancy_reforecasts")
}

model OccupancyReforecastDetail {
  id                                   String  @id @default(uuid()) @db.Uuid
  reforecastId                         String  @map("reforecast_id") @db.Uuid
  month                                Int     @map("month")
  avgPerUnitIncrease                   Float   @default(0) @map("avg_per_unit_increase")
  beginningOccUnits                    Int?    @map("beginning_occ_units")
  endingOccUnits                       Int?    @map("ending_occ_units")
  traffic                              Int     @default(0) @map("traffic")
  netClosingPercent                    Float   @default(0) @map("net_closing_percent")
  leaseExpirations                     Int     @default(0) @map("lease_expirations")
  renewalPercent                       Float   @default(0) @map("renewal_percent")
  skipsEvictionsOther                  Int     @default(0) @map("skips_evictions_other")
  avgLolGainMoveIns                    Float   @default(0) @map("avg_lol_gain_move_ins")
  avgRenewalIncrease                   Float   @default(0) @map("avg_renewal_increase")
  adjustmentForReno                    Float   @default(0) @map("adjustment_for_reno")
  trafficPriorYear                     Int?    @map("traffic_prior_year")
  netClosingPercentPriorYear           Float?  @map("net_closing_percent_prior_year")
  leaseExpirationsPriorYear            Int?    @map("lease_expirations_prior_year")
  renewalPercentPriorYear              Float?  @map("renewal_percent_prior_year")
  skipsEvictionsPriorYear              Int?    @map("skips_evictions_prior_year")
  newLeasesOfferedConcessionsPercent   Float?  @map("new_leases_offered_concessions_percent")
  newLeasesMthAvgRentOfferedConcession Float?  @map("new_leases_mth_avg_rent_offered_concession")
  renewalsOfferedConcessionsPercent    Float?  @map("renewals_offered_concessions_percent")
  renewalsMthAvgRentOfferedConcession  Float?  @map("renewals_mth_avg_rent_offered_concession")
  moveIns                              Int     @default(0) @map("move_ins")
  moveOuts                             Int     @default(0) @map("move_outs")
  vacancyLossOverride                  Float?  @map("vacancy_loss_override")
  vacancyLossIsOverridden              Boolean @default(false) @map("vacancy_loss_is_overridden")

  reforecast OccupancyReforecast @relation(fields: [reforecastId], references: [id], onDelete: Cascade)

  @@unique([reforecastId, month])
  @@map("occupancy_reforecast_details")
}
